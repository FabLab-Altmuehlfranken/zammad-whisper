# Zammad login details
ZAMMAD_URL=
ZAMMAD_TOKEN=

# Title text to search for
# TITLE=""

# Whisper model to use,
# see for available options: https://github.com/openai/whisper#available-models-and-languages
# WHISPER_MODEL=turbo

# Comment customisation
